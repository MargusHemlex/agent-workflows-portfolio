{
  "name": "agent-workflows-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline synthetic evidence and exact-revision review pipeline",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "agent-review-pipeline": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:publication": "node scripts/check-publication.mjs",
    "check": "npm run format:check && npm run lint && npm test && npm run check:publication",
    "examples": "node scripts/generate-examples.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  }
}
