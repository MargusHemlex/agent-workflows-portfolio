{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agent-review:bundle:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "policy", "attempts"],
  "properties": {
    "schemaVersion": { "const": "bundle-v1" },
    "source": { "const": "synthetic" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "requiredChecks", "requiredReviewers"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "requiredChecks": { "const": ["lint", "tests"] },
        "requiredReviewers": { "const": ["quality", "security"] }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/attempt" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSha", "headSha", "files", "contentDigest"],
      "properties": {
        "baseSha": { "$ref": "#/$defs/sha" },
        "headSha": { "$ref": "#/$defs/sha" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9/_.-]*$"
              },
              "content": { "type": "string", "maxLength": 4096 }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "headSha",
        "contentDigest",
        "status",
        "log",
        "logDigest"
      ],
      "properties": {
        "name": { "enum": ["lint", "tests"] },
        "headSha": { "$ref": "#/$defs/sha" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["passed", "failed"] },
        "log": { "type": "string", "maxLength": 4096 },
        "logDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "headSha",
        "contentDigest",
        "evidenceDigest",
        "verdict"
      ],
      "properties": {
        "reviewer": { "enum": ["quality", "security"] },
        "headSha": { "$ref": "#/$defs/sha" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "verdict": { "enum": ["approve", "changes-requested"] }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "checks", "reviews"],
      "properties": {
        "candidate": { "$ref": "#/$defs/candidate" },
        "checks": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/check" }
        },
        "reviews": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/review" }
        }
      }
    }
  }
}
