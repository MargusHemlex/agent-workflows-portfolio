{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agent-review:report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "bundleDigest",
    "reportDigest",
    "policy",
    "status",
    "acceptedHeadSha",
    "evaluatedAttempts",
    "ignoredAttempts",
    "attempts",
    "authority",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "report-v1" },
    "source": { "const": "synthetic" },
    "bundleDigest": { "$ref": "#/$defs/digest" },
    "reportDigest": { "$ref": "#/$defs/digest" },
    "policy": { "$ref": "urn:agent-review:bundle:v1#/properties/policy" },
    "status": {
      "enum": [
        "ready-for-human-review",
        "awaiting-revision",
        "budget-exhausted"
      ]
    },
    "acceptedHeadSha": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }]
    },
    "evaluatedAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
    "ignoredAttempts": { "type": "integer", "minimum": 0, "maximum": 2 },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt",
          "headSha",
          "contentDigest",
          "evidenceDigest",
          "status",
          "reasons"
        ],
        "properties": {
          "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
          "headSha": { "$ref": "#/$defs/sha" },
          "contentDigest": { "$ref": "#/$defs/digest" },
          "evidenceDigest": { "$ref": "#/$defs/digest" },
          "status": { "enum": ["accepted", "rejected"] },
          "reasons": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "enum": [
                "missing_evidence",
                "stale_evidence",
                "failed_check",
                "missing_review",
                "stale_review",
                "changes_requested"
              ]
            }
          }
        }
      }
    },
    "authority": {
      "const": {
        "executeCode": false,
        "modelCalls": false,
        "push": false,
        "merge": false,
        "deploy": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string", "maxLength": 200 }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
